cabal-version:      3.0
name:               luxury-scheme
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  SExpr, Reader
    default-language: GHC2024
    build-depends:    base

executable luxury
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: GHC2024
    build-depends:    base, haskeline, luxury-scheme

executable scratch
    main-is:          Scratch.hs
    hs-source-dirs:   app
    default-language: GHC2024
    build-depends:    base, haskeline, luxury-scheme
